rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders collection: Allow client creation, updates & reads
    match /orders/{orderId} {
      allow read, create, update: if true;
    }

    // Counter for queue position: Allow client transaction reads & updates
    match /meta/counter {
      allow read, create, update: if true;
    }

    // System status / heartbeat
    match /system/{docId} {
      allow read, create, update: if true;
    }
  }
}
